# syntax=docker/dockerfile:1.7
FROM golang:1.25-alpine AS builder
WORKDIR /src
RUN apk add --no-cache git ca-certificates
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags='-s -w' -o /out/krisho-api ./cmd/api

FROM alpine:3.20
WORKDIR /app
RUN addgroup -S app && adduser -S app -G app && apk add --no-cache ca-certificates tzdata curl
COPY --from=builder /out/krisho-api /usr/local/bin/krisho-api
COPY db/migrations ./db/migrations
COPY internal/ai/prompts ./internal/ai/prompts
USER app

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD curl -f http://127.0.0.1:8080/health || exit 1
ENTRYPOINT ["/usr/local/bin/krisho-api"]
