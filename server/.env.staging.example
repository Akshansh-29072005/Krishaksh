SERVER_ENV=staging
SERVER_PORT=8080
DOMAIN=staging-api.krisho.example.com

DB_HOST=your-staging-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_USER=krisho_staging
DB_PASSWORD=change-me
DB_NAME=krisho_staging
DB_SSLMODE=require

REDIS_ADDR=redis:6379
JWT_SECRET=replace-with-strong-secret
GOOGLE_CLIENT_ID=your-google-client-id

AWS_REGION=ap-south-1
S3_BUCKET=krisho-staging-scans

RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=test_secret
RAZORPAY_WEBHOOK_SECRET=whsec_test

GEMINI_API_KEY=...
OPENAI_API_KEY=...

FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase_service_account.json
BACKUP_S3_URI=s3://krisho-staging-backups/postgres
